{
  "name": "peakcam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test lib/*.test.ts 'lib/alerts/*.test.ts' 'lib/game/**/*.test.ts' scripts/*.test.ts tests/*.test.ts",
    "drop-in:sync-three": "node scripts/sync-three.mjs",
    "bake-terrain": "tsx scripts/bake-resort.ts",
    "validate-game-assets": "tsx scripts/validate-game-assets.ts",
    "import-resorts:standalone": "node scripts/import-resorts-standalone.mjs",
    "agents": "node agents/loop.mjs",
    "agents:dry-run": "node agents/loop.mjs --dry-run",
    "agents:extract-plugins": "for f in plugins/*.plugin; do name=$(basename \"$f\" .plugin); mkdir -p \"agents/plugins/$name\" && unzip -o \"$f\" -d \"agents/plugins/$name\"; done",
    "snotel-sync": "tsx scripts/snotel-sync.ts",
    "model-sync": "tsx scripts/model-sync.ts",
    "liftie-sync": "tsx scripts/liftie-sync.ts",
    "snodas-sync": "tsx scripts/snodas-sync.ts",
    "pipeline-sync": "tsx scripts/pipeline-sync.ts",
    "seed-normals": "tsx scripts/seed-snotel-normals.ts",
    "cam-health": "node scripts/cam-health-check.mjs",
    "powder-alerts": "node scripts/powder-alert-check.mjs",
    "generate-images": "node scripts/generate-images.mjs",
    "generate-images:one": "node scripts/generate-images.mjs --name"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.49.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.21.0",
    "motion": "^12.38.0",
    "next": "16.1.6",
    "posthog-js": "^1.362.0",
    "postprocessing": "6.39.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-grid-layout": "^2.2.2",
    "react-map-gl": "^8.1.0",
    "react-resizable": "^3.1.3",
    "resend": "^6.9.4",
    "supercluster": "^8.0.1",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-grid-layout": "^1.3.6",
    "@types/supercluster": "^7.1.3",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "geotiff": "^3.0.5",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
