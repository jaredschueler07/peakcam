{
  "name": "peakcam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "commercialization": "node dashboard/commercialization/server.mjs",
    "commercialization:test": "node --test dashboard/commercialization/server.test.mjs",
    "commercialization:test:browser": "node dashboard/commercialization/browser.test.mjs",
    "lint": "eslint",
    "test": "node --import tsx --test 'lib/**/*.test.ts' 'scripts/**/*.test.ts' 'scripts/**/*.test.mjs' 'tests/**/*.test.ts'",
    "bake-terrain": "tsx scripts/bake-resort.ts",
    "bake-far-field": "tsx scripts/bake-far-field.ts",
    "validate-game-assets": "tsx scripts/validate-game-assets.ts",
    "import-resorts:standalone": "node scripts/import-resorts-standalone.mjs",
    "agents": "node agents/loop.mjs",
    "agents:dry-run": "node agents/loop.mjs --dry-run",
    "agents:extract-plugins": "for f in plugins/*.plugin; do name=$(basename \"$f\" .plugin); mkdir -p \"agents/plugins/$name\" && unzip -o \"$f\" -d \"agents/plugins/$name\"; done",
    "snotel-sync": "tsx scripts/snotel-sync.ts",
    "model-sync": "tsx scripts/model-sync.ts",
    "pipeline-sync": "tsx scripts/pipeline-sync.ts",
    "seed-normals": "tsx scripts/seed-snotel-normals.ts",
    "seed-openings": "node scripts/seed-resort-openings.mjs",
    "cam-health": "node scripts/cam-health-check.mjs",
    "cam-stills": "tsx scripts/cam-capture-stills.ts",
    "forecast-sync": "tsx scripts/forecast-sync.ts",
    "forecast-score": "tsx scripts/forecast-score.ts",
    "powder-alerts": "node scripts/powder-alert-check.mjs",
    "audit-terrain": "tsx scripts/audit-terrain.ts",
    "terrain-readiness": "tsx scripts/terrain-readiness.ts",
    "measure-terrain-resolution": "tsx scripts/measure-terrain-resolution.ts",
    "discover-terrain-sources": "tsx scripts/discover-terrain-sources.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.49.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.21.0",
    "mcp-handler": "2.3.0",
    "motion": "^12.38.0",
    "next": "16.1.6",
    "posthog-js": "^1.362.0",
    "postprocessing": "6.39.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-grid-layout": "^2.2.2",
    "react-map-gl": "^8.1.0",
    "react-resizable": "^3.1.3",
    "resend": "^6.9.4",
    "supercluster": "^8.0.1",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-grid-layout": "^1.3.6",
    "@types/supercluster": "^7.1.3",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "geotiff": "^3.0.5",
    "pngjs": "^7.0.0",
    "proj4": "2.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
