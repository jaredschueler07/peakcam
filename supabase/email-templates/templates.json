{
  "mailer_subjects_confirmation": "Confirm your PeakCam account",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Confirm your PeakCam account</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#f2e8d1;color:#2a1f14;font:16px/1.6 Arial,Helvetica,sans-serif\">\n<table role=\"presentation\" style=\"width:100%;max-width:560px;margin:0 auto;border:1px solid #2a1f14;border-radius:16px;background:#faf4e6\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:28px\">\n<p style=\"margin:0 0 28px;font:bold italic 28px Georgia,serif\">Peak<span style=\"color:#a93f20\">Cam</span></p>\n<h1 style=\"font:700 26px/1.2 Georgia,serif;margin:0 0 18px\">Confirm your email</h1>\n<p style=\"margin:0\">Confirm your email address to finish creating your PeakCam account.</p>\n<p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;border-radius:24px;background:#a93f20;color:#faf4e6;font-weight:bold;text-decoration:none\">Confirm account</a></p>\n<p style=\"margin:24px 0 0;font-size:14px;color:#685342\">If you didn’t request this, you can ignore this email.</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_magic_link": "Your PeakCam sign-in code",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Your PeakCam sign-in code</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#f2e8d1;color:#2a1f14;font:16px/1.6 Arial,Helvetica,sans-serif\">\n<table role=\"presentation\" style=\"width:100%;max-width:560px;margin:0 auto;border:1px solid #2a1f14;border-radius:16px;background:#faf4e6\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:28px\">\n<p style=\"margin:0 0 28px;font:bold italic 28px Georgia,serif\">Peak<span style=\"color:#a93f20\">Cam</span></p>\n<h1 style=\"font:700 26px/1.2 Georgia,serif;margin:0 0 18px\">Your sign-in code</h1>\n<p style=\"margin:0\">Enter this code on the PeakCam sign-in screen. It can be used once. Never share it with anyone.</p>\n<p style=\"margin:24px 0;padding:18px;border:1px solid #2a1f14;border-radius:12px;font:700 32px monospace;letter-spacing:6px;text-align:center;overflow-wrap:anywhere\">{{ .Token }}</p>\n<p style=\"margin:24px 0 0;font-size:14px;color:#685342\">If you didn’t request this code, you can ignore this email. Your account stays unchanged.</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_recovery": "Reset your PeakCam password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Reset your PeakCam password</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#f2e8d1;color:#2a1f14;font:16px/1.6 Arial,Helvetica,sans-serif\">\n<table role=\"presentation\" style=\"width:100%;max-width:560px;margin:0 auto;border:1px solid #2a1f14;border-radius:16px;background:#faf4e6\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:28px\">\n<p style=\"margin:0 0 28px;font:bold italic 28px Georgia,serif\">Peak<span style=\"color:#a93f20\">Cam</span></p>\n<h1 style=\"font:700 26px/1.2 Georgia,serif;margin:0 0 18px\">Choose a new password</h1>\n<p style=\"margin:0\">Use the button below to choose a new password for your PeakCam account.</p>\n<p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;border-radius:24px;background:#a93f20;color:#faf4e6;font-weight:bold;text-decoration:none\">Reset password</a></p>\n<p style=\"margin:24px 0 0;font-size:14px;color:#685342\">If you didn’t request this, you can ignore this email.</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_invite": "Your PeakCam invitation",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Your PeakCam invitation</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#f2e8d1;color:#2a1f14;font:16px/1.6 Arial,Helvetica,sans-serif\">\n<table role=\"presentation\" style=\"width:100%;max-width:560px;margin:0 auto;border:1px solid #2a1f14;border-radius:16px;background:#faf4e6\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:28px\">\n<p style=\"margin:0 0 28px;font:bold italic 28px Georgia,serif\">Peak<span style=\"color:#a93f20\">Cam</span></p>\n<h1 style=\"font:700 26px/1.2 Georgia,serif;margin:0 0 18px\">You’re invited to PeakCam</h1>\n<p style=\"margin:0\">Use the button below to accept your invitation and set up your account.</p>\n<p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;border-radius:24px;background:#a93f20;color:#faf4e6;font-weight:bold;text-decoration:none\">Accept invitation</a></p>\n<p style=\"margin:24px 0 0;font-size:14px;color:#685342\">If you didn’t request this, you can ignore this email.</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_email_change": "Confirm your PeakCam email change",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Confirm your PeakCam email change</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#f2e8d1;color:#2a1f14;font:16px/1.6 Arial,Helvetica,sans-serif\">\n<table role=\"presentation\" style=\"width:100%;max-width:560px;margin:0 auto;border:1px solid #2a1f14;border-radius:16px;background:#faf4e6\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:28px\">\n<p style=\"margin:0 0 28px;font:bold italic 28px Georgia,serif\">Peak<span style=\"color:#a93f20\">Cam</span></p>\n<h1 style=\"font:700 26px/1.2 Georgia,serif;margin:0 0 18px\">Confirm your email change</h1>\n<p style=\"margin:0\">A change to the email address on your PeakCam account was requested. Confirm only if you requested it.</p>\n<p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;border-radius:24px;background:#a93f20;color:#faf4e6;font-weight:bold;text-decoration:none\">Confirm email change</a></p>\n<p style=\"margin:24px 0 0;font-size:14px;color:#685342\">If you didn’t request this, you can ignore this email.</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_reauthentication": "Your PeakCam verification code",
  "mailer_templates_reauthentication_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Your PeakCam verification code</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#f2e8d1;color:#2a1f14;font:16px/1.6 Arial,Helvetica,sans-serif\">\n<table role=\"presentation\" style=\"width:100%;max-width:560px;margin:0 auto;border:1px solid #2a1f14;border-radius:16px;background:#faf4e6\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:28px\">\n<p style=\"margin:0 0 28px;font:bold italic 28px Georgia,serif\">Peak<span style=\"color:#a93f20\">Cam</span></p>\n<h1 style=\"font:700 26px/1.2 Georgia,serif;margin:0 0 18px\">Verify it’s you</h1>\n<p style=\"margin:0\">Enter this code on PeakCam to confirm your identity. Never share it with anyone.</p>\n<p style=\"margin:24px 0;padding:18px;border:1px solid #2a1f14;border-radius:12px;font:700 32px monospace;letter-spacing:6px;text-align:center;overflow-wrap:anywhere\">{{ .Token }}</p>\n<p style=\"margin:24px 0 0;font-size:14px;color:#685342\">If you didn’t request this code, you can ignore this email. Your account stays unchanged.</p>\n</td></tr></table></body></html>\n"
}
